# Copy to .env.local, add OpenAI and Stripe test keys, and replace WALLET_SECRET.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WALLET_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Local catalog research makes no Tavily calls. Production: web + a Tavily key.
GIFT_RESEARCH_MODE=catalog
TAVILY_API_KEY=

# Local memory is disabled unless explicitly enabled.
COGNEE_ENABLED=false
COGNEE_API_KEY=
COGNEE_API_URL=https://api.cognee.ai

# Outgoing Stripe sandbox demo: set PAYMENT_PROVIDER=stripe and add a test key.
# payout needs an owner-configured platform GBP test bank and debits available sandbox funds.
# The platform default GBP bank is used; no explicit destination is required.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_FLOW=payout
SPENDING_ALLOWANCE_PENCE=34600
# Only for the optional transfer flow, which needs an enabled Connect recipient:
STRIPE_MERCHANT_ACCOUNTS={}
