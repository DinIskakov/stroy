# Local MVP. Copy to .env.local, add your OpenAI key, and replace WALLET_SECRET.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WALLET_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Local catalog research makes no Tavily calls. Production: web + a Tavily key.
GIFT_RESEARCH_MODE=catalog
TAVILY_API_KEY=

# Local memory is disabled unless explicitly enabled.
COGNEE_ENABLED=false
COGNEE_API_KEY=
COGNEE_API_URL=https://api.cognee.ai

# Switch to stripe only after configuring a funded Stripe sandbox and test merchant accounts.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_MERCHANT_ACCOUNTS={}
